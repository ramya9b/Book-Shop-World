{
  "rules": {
    "catalog": {
      ".read": true,
      ".write": "auth !== null && auth.token.email === 'srrgkenterprises@gmail.com'"
    },
    "shopStatus": {
      ".read": true,
      ".write": "auth !== null && auth.token.email === 'srrgkenterprises@gmail.com'"
    },
    "catalogCost": {
      ".read": "auth !== null && auth.token.email === 'srrgkenterprises@gmail.com'",
      ".write": "auth !== null && auth.token.email === 'srrgkenterprises@gmail.com'"
    },
    "pageViews": {
      "$day": {
        ".read": true,
        ".write": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)"
      }
    },
    "waClicks": {
      "$day": {
        ".read": "auth !== null && auth.token.email === 'srrgkenterprises@gmail.com'",
        "$label": {
          ".write": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)"
        }
      }
    }
  }
}
